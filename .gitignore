*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
*.log

# Virtual environments
venv/
myenv/
.env/
# uv 建立的虛擬環境（myapp/.venv/；分析服務的資料夾在 Mac 上誤執行 uv sync 也會產生）
.venv/
# briefcase dev 的開發環境與標記檔（myapp/.briefcase/）
.briefcase/
# pytest --cov 的輸出
.coverage
htmlcov/

# IDE, Editor
.vscode/
.idea/

# OS generated
.DS_Store
Thumbs.db

# Video, binary, PDF, output files
*.mp4
*.avi
*.mov
*.mkv
*.mp3
*.wav
*.flac
*.pdf
*.png
*.jpg
*.jpeg
*.heic
*.bmp
# 例外：移植版端對端測試用的合成對話（macOS 的 say 產生，不是錄音；services/analyzer/e2e/make_dialogue.py）
!services/analyzer/e2e/fixtures/dialogue.wav
# 例外：app 畫面用到的圖片（圖示、開場畫面、登入背景）要進 git，來源與授權見 myapp/src/myapp/images/SOURCES.md
!myapp/src/myapp/images/**/*.png
!myapp/src/myapp/images/**/*.jpg
# README diagrams and UI screenshots; editable SVG sources live beside the diagram previews.
!/assets/readme/architecture.png
!/assets/readme/analysis-pipeline.png
!/assets/readme/user-workflow.png
!/assets/readme/screenshots/*.png

# 其他
output.*
myapp/output.mp4
myapp/video.mp4
myapp/src/myapp/init/output_cam1.avi
myapp/src/myapp/init/output_cam2.avi
myapp/src/myapp/init/adam-*.json

# 環境變數檔案
.env

# 本地媒體快取目錄
myapp/src/myapp/init/media/
myapp/src/myapp/init/charts/
myapp/video/
myapp/audio/
myapp/pdf/

# 資料庫備份檔案
*.sql
# Reviewed test schema only; database dumps and local deployment SQL stay ignored.
!myapp/tests/fixtures/schema.sql
# 分析服務的整合測試用的最小權限帳號（只有測試用的密碼）
!services/*/tests/integration/grants.sql
*.dump
backup/

# 臨時檔案
*.tmp
*.temp

docs

# 原本的分析服務：程式裡寫死了密鑰，只當參考，不進 git（見 docs/rebuild/steps/06_analyzer.md 的 6-0）
service_analyzer/
**/adam-*.json

# 不屬於產品的本機檔案：AI 代理的說明與工作樹、研究筆記、暫存輸出、S3 教學的上傳測試檔
/AGENTS.md
/CLAUDE.md
.claude/
/research_notes/
/reports/
/tmp/
/test.txt
/downloaded-test.txt

